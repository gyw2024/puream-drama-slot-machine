{
  "name": "puream-drama-slot-h3",
  "version": "0.16.359",
  "description": "纯梦短剧老虎机：H3 云端视频与资产直投的一键短剧生产工具",
  "main": "app/bootstrap.js",
  "author": "PUREAM",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "version": "node scripts/release-version-contract.js --sync",
    "test": "node --test scripts/*.test.js",
    "verify:build-assets": "node scripts/verify-build-assets.js",
    "prepare:build-assets": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-build-assets.ps1",
    "sync:drama-skill": "node scripts/sync-drama-skill.js --write",
    "prebuild:dir": "npm run verify:build-assets && node scripts/verify-electron-runtime.js && node scripts/sync-drama-skill.js",
    "build:dir": "electron-builder --win dir --x64",
    "prebuild:installer": "npm run verify:build-assets && node scripts/verify-electron-runtime.js && node scripts/sync-drama-skill.js",
    "build:installer": "electron-builder --win nsis --x64",
    "audit:packaged": "node scripts/audit-packaged.js",
    "audit:installed": "node scripts/audit-installed.js",
    "audit:foundry-relocation": "node scripts/audit-foundry-storage-relocation.js",
    "audit:live-upgrade": "node scripts/audit-live-upgrade.js",
    "audit:upload-transport": "electron scripts/electron-upload-transport.audit.js"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.62.1"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "cn.puream.drama-slot-machine",
    "productName": "纯梦短剧老虎机",
    "artifactName": "纯梦短剧老虎机-安装版-${version}.${ext}",
    "asar": true,
    "files": [
      "app/**/*",
      "!app/**/__pycache__/**",
      "!app/assets/builtin-sfx/**/*",
      "!app/renderer/index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app/local-audio-performance.py",
        "to": "agents/local-audio-performance.py"
      },
      {
        "from": "app/local-active-speaker.py",
        "to": "agents/local-active-speaker.py"
      },
      {
        "from": "app/local-media-asr.py",
        "to": "agents/local-media-asr.py"
      },
      {
        "from": "app/local-agent-dsh.py",
        "to": "agents/local-agent-dsh.py"
      },
      {
        "from": "media-tools",
        "to": "media-tools"
      },
      {
        "from": "app/assets/builtin-sfx",
        "to": "builtin-sfx"
      },
      {
        "from": "app/mcp/packaged-stdio-entry.js",
        "to": "mcp/packaged-stdio-entry.js"
      },
      {
        "from": "app/mcp/stage-delivery-entry.js",
        "to": "mcp/stage-delivery-entry.js"
      }
    ],
    "directories": {
      "output": "dist-fixed-0.16.359"
    },
    "win": {
      "icon": "app/assets/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "guid": "316c72bd-3643-54c3-8e80-9c42a313b0eb",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "纯梦短剧老虎机",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0"
  }
}
