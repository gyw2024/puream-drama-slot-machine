{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "verdict",
          "reason",
          "issues",
          "missingEvidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "defect",
              "needs_evidence",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceFactId",
                "promptFactId",
                "ruleId",
                "contradiction",
                "repair"
              ],
              "properties": {
                "sourceFactId": {
                  "type": "string",
                  "minLength": 1
                },
                "promptFactId": {
                  "type": "string",
                  "minLength": 1
                },
                "ruleId": {
                  "type": "string",
                  "minLength": 1
                },
                "contradiction": {
                  "type": "string",
                  "minLength": 1
                },
                "repair": {
                  "type": "string",
                  "minLength": 1
                },
                "boundarySourceFactIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          },
          "missingEvidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requirement",
                "reason",
                "affectedIds"
              ],
              "properties": {
                "requirement": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "affectedIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      },
      "minItems": 1
    }
  }
}
